{
  "name": "art-gallery",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bump": "npm version patch --no-git-tag-version && node scripts/update-version-file.js",
    "deploy": "npm run bump && npm run build && git add . && git commit -m \"Bump version & deploy\" && git push origin main && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
